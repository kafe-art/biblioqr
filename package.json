{
  "name": "biblioqr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "build": "prisma generate && tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "preview": "vite preview",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:provider": "node scripts/prisma-provider.cjs",
    "db:seed-history": "tsx scripts/seed-history.ts",
    "start": "tsx server/index.ts",
    "start:render": "prisma db push --skip-generate && tsx scripts/purge-demo-data.ts && tsx scripts/seed-catalog.ts && tsx server/index.ts",
    "db:seed-catalog": "tsx scripts/seed-catalog.ts",
    "db:purge-demo": "tsx scripts/purge-demo-data.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "prisma": "^6.19.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "rolldown": "^1.2.19",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
