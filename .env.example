# =============================================================================
# BiblioQR - Variables de entorno de ejemplo
# Copia este archivo a .env y define los valores adecuados para tu entorno.
# =============================================================================

# Base de datos (SQLite o PostgreSQL)
# Ejemplo SQLite: file:./dev.db | Ejemplo PostgreSQL: postgresql://usuario:clave@localhost:5432/biblioqr
DATABASE_URL=file:./dev.db

# Puerto en el que escucha el servidor Express API
PORT=3000

# Origen permitido para CORS (coincide con la URL del cliente Vite)
CORS_ORIGIN=http://localhost:5173

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Clave secreta para firma y verificación de tokens JWT (mínimo 32 caracteres)
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_32_caracteres_aqui

# Clave HMAC secreta para validación de códigos QR (mínimo 32 caracteres, distinta de JWT_SECRET)
QR_HMAC_SECRET=tu_clave_secreta_hmac_qr_distinta_de_al_menos_32_caracteres

# Contraseña inicial para usuarios de demostración en el script de seed (mínimo 12 caracteres)
SEED_DEMO_PASSWORD=contrasena_demo_segura_16caract

# -----------------------------------------------------------------------------
# Políticas de negocio de préstamos y biblioteca (de src/lib/rules.ts)
# -----------------------------------------------------------------------------

# Días estándar de préstamo de libros
POLICY_LOAN_DAYS=14

# Días que se agregan por cada renovación
POLICY_RENEWAL_DAYS=7

# Cantidad máxima de renovaciones permitidas por préstamo
POLICY_MAX_RENEWALS=2

# Cantidad máxima de préstamos simultáneos permitidos por usuario
POLICY_MAX_LOANS=3

# Horas que se mantiene una reserva disponible desde la hora de recojo antes de caducar
POLICY_HOLD_HOURS=24

# Tarifa de multa por cada día de mora
POLICY_FINE_PER_DAY=1.5

# Símbolo de moneda utilizado para cobros y multas
POLICY_CURRENCY=S/

# Días antes del vencimiento en los que el semáforo de cuenta pasa a ámbar
POLICY_WARN_DAYS=3
